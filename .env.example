# Copy to .env.local for Next.js. Prisma CLI/seed use .env (or export variables).
# Runtime: Supabase transaction pooler, port 6543, pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations: direct database or session pooler port 5432.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="REPLACE_WITH_PUBLISHABLE_KEY"
# Public origin only, without /siwes. Never derived from untrusted request headers.
NEXT_PUBLIC_SITE_ORIGIN="http://localhost:3000"
# Empty for domain root; /siwes for subpath. Requires rebuild when changed.
NEXT_PUBLIC_BASE_PATH=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# UUID from Supabase Auth, used ONLY by the provisioning CLI.
ADMIN_USER_ID=""
# Seed taxonomy and explicitly marked demonstration project (never personal claims).
SEED_DEMO="false"
